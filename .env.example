# Copy to .env (git-ignored) and fill in; docker compose reads it automatically.
# Everything here is optional — anything left blank can be set on the Settings page.

PLEX_URL=http://192.168.1.100:32400
PLEX_TOKEN=your-plex-token-here
# Library section IDs to sync, comma separated (Settings -> Libraries shows them)
LIBRARY_IDS=1,2

#SCHEDULE_DAYS_AHEAD=3
#PUBLIC_URL=http://192.168.1.50:5000

# Port to publish on the host (the app itself always listens on 5000 in the container)
#HOST_PORT=5000
